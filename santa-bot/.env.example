# =====================================================================================
# Настройки бота «Санта в чате».
# Как пользоваться: скопируйте этот файл командой  cp .env.example .env
# и заполните .env. Сам .env никому не отправляйте и не публикуйте: в нём пароли.
# Формат строки: ИМЯ=значение — без пробелов вокруг «=» и без кавычек.
# После любых правок в .env выполните:  docker compose up -d
# Подробности — в README_RU.md.
# =====================================================================================


# ----------------------------- Сайт и домен ------------------------------------------

# Ваш домен без https:// и без слеша на конце. Нужен всем: сайт, оплата, вебхук MAX.
# Где взять: купить у регистратора (например REG.RU или RU-CENTER) и направить A-запись
# на IP-адрес сервера. Пример: santa-v-chate.ru
DOMAIN=

# Полный адрес сайта. Можно оставить пустым — тогда возьмётся https://DOMAIN.
# Заполняйте, только если сайт открывается по другому адресу. Пример: https://santa-v-chate.ru
PUBLIC_BASE_URL=


# ----------------------------- Бот в MAX ---------------------------------------------

# Токен бота. Без него бот выключен, но сайт работает (так удобно сначала показать сайт Robokassa).
# Где взять: платформа MAX для партнёров (business.max.ru) → «Чат-боты» → ваш бот →
# «⋮» → «Настройки» → «Токен доступа» → значок копирования. Токен появляется после модерации бота.
# Пример: AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
MAX_BOT_TOKEN=

# Никнейм бота — из карточки бота на платформе, из ссылки max.ru/<никнейм>.
# У самозанятых он выдаётся автоматически и выглядит как se1234567_bot.
# Все ссылки-приглашения строятся из этого значения — ошибка здесь ломает приглашения.
# Обязателен, если задан MAX_BOT_TOKEN. Пример: se1234567_bot
MAX_BOT_USERNAME=

# Адрес API MAX. Не меняйте. Старый адрес platform-api.max.ru больше не работает.
MAX_API_BASE=https://platform-api2.max.ru

# Как бот получает сообщения: webhook — для сервера (правильный вариант);
# polling — только для ручной проверки на своём компьютере. Оставьте webhook.
MODE=webhook

# Секрет, по которому бот узнаёт, что запрос пришёл именно от MAX.
# Можно оставить пустым: при первом запуске бот сам придумает значение, один раз покажет его
# в журнале и сохранит в data/secrets.env. Если хотите задать сами: 32 символа из латинских
# букв, цифр и «-», например результат команды  openssl rand -hex 16
MAX_WEBHOOK_SECRET=

# Секретная часть адреса вебхука (https://DOMAIN/max/webhook/<секрет>), чтобы адрес нельзя
# было угадать. Можно оставить пустым — сгенерируется сам, как предыдущий.
# Если задаёте сами: 24 случайных символа из латинских букв и цифр (openssl rand -hex 12).
WEBHOOK_PATH_SECRET=


# ----------------------------- Оплата: Robokassa -------------------------------------
# Все значения — из личного кабинета Robokassa: «Мои магазины» → ваш магазин →
# «Технические настройки». Пока ROBOKASSA_MERCHANT_LOGIN пуст, оплата выключена:
# бот работает только с бесплатными играми.

# Идентификатор магазина (MerchantLogin) — вверху страницы технических настроек.
# Пример: santa-v-chate
ROBOKASSA_MERCHANT_LOGIN=

# Боевые пароли: «Пароль #1» и «Пароль #2» (настоящие платежи, ROBOKASSA_TEST=0).
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# Тестовые пароли: раздел «Параметры проведения тестовых платежей» на той же странице
# (свои «Пароль #1» и «Пароль #2»; они ДРУГИЕ, чем боевые). Нужны при ROBOKASSA_TEST=1.
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=

# 1 — тестовый режим: деньги не списываются, используются тестовые пароли.
# Поставьте 0 только после успешного тестового платежа (порядок — в README_RU.md).
ROBOKASSA_TEST=1

# Алгоритм подписи. Должен совпадать с «Алгоритм расчёта хеша» в кабинете Robokassa
# (и в боевом, и в тестовом разделе). Можно md5, sha256 или sha512. Рекомендуем md5.
ROBOKASSA_HASH=md5

# 1 — бот сам передаёт в Robokassa данные для чека. Самозанятым НЕ нужно: чеки в «Мой налог»
# автоматически пробивает сервис Robokassa «Робочеки СМЗ». Оставьте 0.
ROBOKASSA_SEND_RECEIPT=0


# ----------------------------- Администраторы ----------------------------------------

# Ваш id в MAX (и id помощников) через запятую — им доступны команды /stats, /game, /price и т.д.
# и им приходят сводки и тревоги. Где взять: напишите боту /whoami — он ответит «Ваш id в MAX: …».
# Пример: 12345678,87654321
ADMIN_USER_IDS=

# Пароль для выгрузки таблиц (платежи, игры, события; дополнительная функция) по ссылке
# https://DOMAIN/admin/export/payments.csv?token=<пароль>. Можно оставить пустым — сгенерируется
# сам и сохранится в data/secrets.env. Никому не передавайте.
ADMIN_EXPORT_TOKEN=


# ----------------------------- Продавец (для юридических страниц) --------------------
# Показываются в оферте, политике, на странице контактов и в подвале сайта. Их проверяют
# Robokassa и модерация MAX. Обязательны, как только включены бот или оплата.

# ФИО полностью, как в «Мой налог». Пример: Иванов Иван Иванович
OWNER_FULL_NAME=

# ИНН самозанятого — 12 цифр; он указан в профиле в приложении «Мой налог». Пример: 771234567890
OWNER_INN=

# Почта для вопросов, жалоб, возвратов и заявок на большие игры. Её видят пользователи.
# Пример: help@santa-v-chate.ru
SUPPORT_EMAIL=


# ----------------------------- Цены и лимиты -----------------------------------------
# Используются только при ПЕРВОМ запуске. Потом цены меняются командой /price в боте
# (например «/price S 590»), а эти строки уже ни на что не влияют.

# Сколько участников можно бесплатно (не меньше 3). Организатор тоже считается, если играет.
FREE_LIMIT=10

# Тариф S: до LIMIT_S участников за PRICE_S рублей, один раз за игру.
PRICE_S=490
LIMIT_S=30

# Тариф M.
PRICE_M=990
LIMIT_M=100

# Тариф L. Если людей больше — бот предлагает написать на SUPPORT_EMAIL.
PRICE_L=2490
LIMIT_L=300


# ----------------------------- Прочее ------------------------------------------------

# Версия текста согласия на обработку данных; сохраняется вместе с каждым согласием.
# Меняйте (например на 2027-01), только если существенно изменили текст согласия на сайте.
CONSENT_VERSION=2026-10

# Часовой пояс сервера. Не меняйте: расписание бота (напоминания, сводки) — по Москве.
TZ=Europe/Moscow

# Период, когда администраторам каждый день в 21:00 по Москве приходит сводка.
# Формат ММ-ДД. По умолчанию с 1 ноября по 10 января.
DIGEST_FROM=11-01
DIGEST_TO=01-10


# ----------------------------- Необязательное ----------------------------------------

# Номер счётчика Яндекс Метрики — только для статистики посещений сайта (не бота).
# Где взять: metrika.yandex.ru → счётчик → номер из цифр. Пример: 98765432.
# Пусто — Метрики нет (так проще: не нужно упоминать cookies в политике).
METRICA_ID=

# Хранилище S3 в России (например Yandex Object Storage, Selectel, Timeweb Cloud) для копий базы.
# Пусто — копии хранятся только на сервере в data/backups. Заполняйте все четыре или ни одного.
# Где взять: в панели облака создайте бакет и ключ доступа. Пример адреса: https://storage.yandexcloud.net
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
# Регион хранилища: Yandex Object Storage — ru-central1 (по умолчанию), Selectel и Timeweb Cloud — ru-1.
S3_REGION=

# Зеркало PyPI для сборки, если сервер не может скачать пакеты с pypi.org.
# Используется только командой docker compose build. Пусто — обычный pypi.org.
# Пример: https://mirror.yandex.ru/pypi/web/simple
PIP_INDEX_URL=

# Для разработчика. В Docker не меняйте: адрес папки данных и порт жёстко связаны
# с docker-compose.yml и Caddyfile.
# DATA_DIR=/data
# PORT=8080
